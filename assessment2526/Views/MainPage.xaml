<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:assessment2526.ViewModels"
             x:Class="assessment2526.MainPage"
             x:DataType="vm:MainViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="25">

            <VerticalStackLayout Spacing="5">
                <Label Text="MyFitnessStats"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Label Text="Track your runs. Improve every day."
                       FontSize="14"
                       Opacity="0.7"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            
            
            <Border BackgroundColor="{DynamicResource CardColor}"
                    StrokeShape="RoundRectangle 25"
                    Padding="25">

                <VerticalStackLayout Spacing="20">

                    <Label Text="Ready to start your run?"
                           HorizontalOptions="Center" />

                    <Button Text="Start Run"
                            Command="{Binding StartRunCommand}" />

                    <Button Text="Settings"
                            Command="{Binding GoToSettingsCommand}" />

                    <Button Text="View History"
                            Command="{Binding GoToHistoryCommand}"/>

                    <Button Text="Help"
                            Command="{Binding GoToHelpCommand}"
                            SemanticProperties.Description="Open help and user instructions" /> 

                </VerticalStackLayout>
            </Border>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
